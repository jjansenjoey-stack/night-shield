# Night Shield environment
#
# Leave these EMPTY to run the app on the built-in local provider
# (seeded Tilburg data, persisted to localStorage). Fill them in to
# switch every service over to a real Supabase backend — no code changes.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: OpenWeatherMap free API key (prompt 41).
# Without it the app falls back to Open-Meteo, which needs no key.
VITE_OPENWEATHER_API_KEY=
